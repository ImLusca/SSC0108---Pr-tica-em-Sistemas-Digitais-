set_global_assignment -name BDF_FILE Adder/fulladder.bdf
set_global_assignment -name BDF_FILE Subtractor/sub.bdf
set_global_assignment -name BDF_FILE minicpu.bdf
set_global_assignment -name BDF_FILE ULA/multiplicador.bdf
set_global_assignment -name BDF_FILE ULA/divisor.bdf
set_global_assignment -name QIP_FILE MUX_ULA.qip