set_global_assignment -name BDF_FILE Adder/sum4.bdf
set_global_assignment -name BDF_FILE "Multiplicador por 2/multiplicador.bdf"
set_global_assignment -name BDF_FILE "Divisor por 2/divisor.bdf"
